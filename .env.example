# MongoDB Connection URI (MongoDB Atlas or Local)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/leadorbit?retryWrites=true&w=majority

# Auth JWT signing secret (at least 32 characters)
JWT_SECRET=change-this-to-a-long-random-secret-key-for-leadorbit

# Master AES-256 encryption key for Admin API Vault (32+ characters)
APP_ENCRYPTION_KEY=change-this-to-a-32-char-master-encryption-key

